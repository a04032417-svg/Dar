"inputs": [
{
"k": "price",
"n": {
"en": "Purchase price",
"ar": "سعر الشراء"
},
"fmt": "money",
"v": 1500000
},
{
"k": "fees",
"n": {
"en": "Purchase costs %",
"ar": "تكاليف الشراء %"
},
"fmt": "pct",
"v": 0.05
},
{
"k": "ltv",
"n": {
"en": "Financing %",
"ar": "نسبة التمويل"
},
"fmt": "pct",
"v": 0.6
},
{
"k": "rate",
"n": {
"en": "Financing rate",
"ar": "نسبة التمويل السنوية"
},
"fmt": "pct",
"v": 0.055
},
{
"k": "yrs",
"n": {
"en": "Financing years",
"ar": "سنوات التمويل"
},
"fmt": "int",
"v": 20
},
{
"k": "rent",
"n": {
"en": "Year-1 rent",
"ar": "إيجار السنة الأولى"
},
"fmt": "money",
"v": 105000
},
{
"k": "rg",
"n": {
"en": "Rent growth",
"ar": "نمو الإيجار"
},
"fmt": "pct",
"v": 0.03
},
{
"k": "vac",
"n": {
"en": "Vacancy",
"ar": "الشغور"
},
"fmt": "pct",
"v": 0.05
},
{
"k": "opex",
"n": {
"en": "Operating costs % of rent",
"ar": "التكاليف % من الإيجار"
},
"fmt": "pct",
"v": 0.18
},
{
"k": "ap",
"n": {
"en": "Value growth",
"ar": "نمو القيمة"
},
"fmt": "pct",
"v": 0.03
}
],
"outputs": [
{
"k": "cash",
"n": {
"en": "Cash invested",
"ar": "النقد المستثمر"
},
"fmt": "money",
"f": "{price}*(1-{ltv})+{price}*{fees}"
},
{
"k": "ds",
"n": {
"en": "Debt service / year",
"ar": "خدمة الدين سنوياً"
},
"fmt": "money",
"f": "PMT({rate}/12,{yrs}*12,-{price}*{ltv})*12"
},
{
"k": "coc",
"n": {
"en": "Year-1 cash-on-cash",
"ar": "العائد النقدي للسنة الأولى"
},
"fmt": "pct",
"f": "({rent}*(1-{vac})*(1-{opex})-{ds})/{cash}",
"hl": true
},
{
"k": "cap",
"n": {
"en": "Entry cap rate",
"ar": "معدل الرسملة عند الشراء"
},
"fmt": "pct",
"f": "{rent}*(1-{vac})*(1-{opex})/{price}"
}
],
"table": {
"title": {
"en": "Year by year",
"ar": "سنة بسنة"
},
"rows": 10,
"cols": [
{
"k": "noi",
"n": {
"en": "Net operating income",
"ar": "صافي الدخل التشغيلي"
},
"fmt": "money",
"f": "{p:noi}*(1+{rg})",
"f0": "{rent}*(1-{vac})*(1-{opex})"
},
{
"k": "cf",
"n": {
"en": "Cash flow after debt",
"ar": "التدفق بعد التمويل"
},
"fmt": "money",
"f": "{c:noi}-{ds}",
"f0": "{c:noi}-{ds}"
},
{
"k": "value",
"n": {
"en": "Property value",
"ar": "قيمة العقار"
},
"fmt": "money",
"f": "{p:value}*(1+{ap})",
"f0": "{price}*(1+{ap})"
},
{
"k": "loan",
"n": {
"en": "Loan balance",
"ar": "رصيد التمويل"
},
"fmt": "money",
"f": "-PV({rate}/12,MAX(0,{yrs}-{n})*12,{ds}/12)",
"f0": "-PV({rate}/12,({yrs}-{n})*12,{ds}/12)"
},
{
"k": "equity",
"n": {
"en": "Equity",
"ar": "حقوق الملكية"
},
"fmt": "money",
"f": "{c:value}-{c:loan}",
"f0": "{c:value}-{c:loan}"
},
{
"k": "ret",
"n": {
"en": "Total return on cash",
"ar": "العائد الكلي على النقد"
},
"fmt": "pct",
"f": "({c:equity}+{c:cf}+{p:cf}-{cash})/{cash}",
"f0": "({c:equity}+{c:cf}-{cash})/{cash}"
}
],
"chart": {
"t": "line",
"cols": [
"value",
"equity"
]
}
}
},
