},
{
"k": "score",
"n": {
"en": "Radar score / 100",
"ar": "درجة الرادار من 100"
},
"t": "calc",
"fmt": "int",
"f": "=ROUND(MIN(100,MIN(1,{yld}/0.08)*35+MIN(1,{ratio}/3)*30+MAX(0,1-{dom}/180)*20+MIN(1,{tx}/15)*15),0)",
"cf": "databar"
},
{
"k": "signal",
"n": {
"en": "Signal",
"ar": "الإشارة"
},
"t": "calc",
"fmt": "text",
"f": "=IF({score}>=70,{tx:Strong buy zone/منطقة شراء قوية},IF({score}>=50,{tx:Watch closely/راقب عن قرب},{tx:Caution/حذر}))"
}
