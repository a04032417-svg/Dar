},
"t": "calc",
"fmt": "num",
"f": "=IFERROR(AVERAGEIFS({#comps.dom},{#comps.district},{district}),0)",
"cf": "scale_r"
},
{
"k": "supply",
"n": {
"en": "Unsold new units",
"ar": "وحدات جديدة غير مباعة"
},
"t": "calc",
"fmt": "int",
"f": "=SUMIFS({#supply.left},{#supply.district},{district})",
"cf": "scale_r"
},
{
"k": "dem",
"n": {
"en": "Demand signals",
"ar": "مؤشرات الطلب"
},
"t": "calc",
"fmt": "int",
"f": "=SUMIFS({#demand.count},{#demand.district},{district})",
"cf": "scale"
},
{
"k": "ratio",
