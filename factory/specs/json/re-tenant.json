"en": "Net cost of renting",
"ar": "صافي تكلفة الإيجار"
},
"fmt": "money",
"f": "{c:rc}-{price}*{down}*((1+{inv})^{n}-1)",
"f0": "{c:rc}-{price}*{down}*((1+{inv})^{n}-1)"
