"ar": "قسّم الإيجار حسب مساحة الغرف لا بالتساوي."
},
"inputs": [
{
"k": "rent",
"n": {
"en": "Total rent / month",
"ar": "إجمالي الإيجار الشهري"
},
"fmt": "money",
"v": 9000
},
{
"k": "common",
"n": {
"en": "Share paid equally %",
"ar": "الجزء المقسوم بالتساوي %"
},
"fmt": "pct",
"v": 0.4
},
{
"k": "people",
"n": {
"en": "People",
"ar": "عدد الأشخاص"
},
"fmt": "int",
"v": 3
},
{
"k": "r1",
"n": {
"en": "My room m²",
"ar": "مساحة غرفتي م²"
},
"fmt": "num",
"v": 18
},
{
"k": "r2",
"n": {
"en": "Room 2 m²",
"ar": "مساحة الغرفة 2 م²"
},
"fmt": "num",
"v": 14
},
{
"k": "r3",
"n": {
"en": "Room 3 m²",
"ar": "مساحة الغرفة 3 م²"
},
"fmt": "num",
"v": 11
}
],
"outputs": [
{
"k": "eq",
"n": {
"en": "Equal part each",
"ar": "الجزء المتساوي لكل شخص"
},
"fmt": "money",
"f": "{rent}*{common}/{people}"
},
{
"k": "me",
"n": {
"en": "My rent",
"ar": "إيجاري"
},
"fmt": "money",
"f": "{eq}+{rent}*(1-{common})*{r1}/({r1}+{r2}+{r3})",
"hl": true
},
{
"k": "p2",
"n": {
"en": "Room 2 rent",
"ar": "إيجار الغرفة 2"
},
"fmt": "money",
"f": "{eq}+{rent}*(1-{common})*{r2}/({r1}+{r2}+{r3})"
},
{
"k": "p3",
"n": {
"en": "Room 3 rent",
"ar": "إيجار الغرفة 3"
},
"fmt": "money",
"f": "{eq}+{rent}*(1-{common})*{r3}/({r1}+{r2}+{r3})"
}
]
},
{
"id": "deposit",
"g": "files",
"n": {
"en": "Deposit refund check",
"ar": "تقدير استرداد التأمين"
},
"d": {
"en": "Estimate what you should get back and dispute unfair deductions.",
"ar": "قدّر ما يجب أن تسترده واعترض على الخصومات غير العادلة."
},
"inputs": [
{
"k": "dep",
"n": {
"en": "Deposit paid",
"ar": "التأمين المدفوع"
},
"fmt": "money",
"v": 5000
},
{
"k": "paint",
"n": {
"en": "Painting deduction",
"ar": "خصم الدهان"
},
"fmt": "money",
"v": 600
},
{
"k": "clean",
"n": {
"en": "Cleaning deduction",
"ar": "خصم التنظيف"
},
"fmt": "money",
"v": 300
},
{
"k": "dmg",
"n": {
"en": "Damage repairs",
"ar": "إصلاح الأضرار"
},
"fmt": "money",
"v": 0
},
{
"k": "unpaid",
"n": {
"en": "Unpaid bills / rent",
"ar": "فواتير أو إيجار غير مدفوع"
},
"fmt": "money",
"v": 0
},
{
"k": "wear",
"n": {
"en": "Share that is normal wear (not chargeable)",
"ar": "نسبة الاستهلاك الطبيعي (غير قابلة للخصم)"
},
"fmt": "pct",
"v": 0.5
}
],
"outputs": [
{
"k": "claim",
"n": {
"en": "Deductions claimed",
"ar": "الخصومات المطالب بها"
},
"fmt": "money",
"f": "{paint}+{clean}+{dmg}+{unpaid}"
},
{
"k": "fair",
"n": {
"en": "Fair deductions",
"ar": "الخصومات العادلة"
},
"fmt": "money",
"f": "({paint}+{clean})*(1-{wear})+{dmg}+{unpaid}"
},
{
"k": "back",
"n": {
"en": "Fair refund",
"ar": "الاسترداد العادل"
},
"fmt": "money",
"f": "MAX(0,{dep}-{fair})",
"hl": true
},
{
"k": "dispute",
"n": {
"en": "Amount worth disputing",
"ar": "المبلغ الذي يستحق الاعتراض"
},
"fmt": "money",
"f": "{claim}-{fair}"
}
]
}
],
