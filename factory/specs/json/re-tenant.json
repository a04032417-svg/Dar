},
{
"k": "bal",
"n": {
"en": "Loan balance",
"ar": "رصيد التمويل"
},
"fmt": "money",
"f": "-PV({rate}/12,MAX(0,{yrs}-{n})*12,PMT({rate}/12,{yrs}*12,-{price}*(1-{down})))",
